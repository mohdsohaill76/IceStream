# Kafka Cluster & Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BOOTSTRAP_SERVERS=localhost:9092

# Pipeline Topics (Aligned with Team Contract & Harsh's DQ Module)
KAFKA_INPUT_TOPIC=ecommerce-transactions
INPUT_TOPIC=ecommerce-transactions

KAFKA_VALID_TOPIC=processed-transactions
VALID_OUTPUT_TOPIC=processed-transactions

# Unified DLQ Topic
KAFKA_DLQ_TOPIC=ecommerce-transactions-dlq
DLQ_OUTPUT_TOPIC=ecommerce-transactions-dlq

# Consumer Group
KAFKA_CONSUMER_GROUP=flink_ecommerce_group
CONSUMER_GROUP=flink_ecommerce_group

# Flink Checkpoint & Execution Configuration (POSIX/Linux & Windows Portable)
FLINK_CHECKPOINT_DIR=/tmp/flink-checkpoints
FLINK_PARALLELISM=1
FLINK_CHECKPOINT_INTERVAL_MS=10000
FLINK_MAX_OUT_OF_ORDERNESS_SEC=5